rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Пользователь может читать и изменять только собственный профиль
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Пользователь может читать и изменять только свои избранные города
      match /favorites/{favoriteId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
